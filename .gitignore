# Project exclude paths
/.gradle/
/.idea/
/build/
/bin/
/run/
/out/
/logs/
/libs/
*.log
*.bak

# Never commit jars (build artifacts) — except the Gradle wrapper bootstrap
*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDE / editor files
/.eclipse/
/.vscode/

# Claude Code project files
/.claude/

# Local dev / deployment scripts
/dev-notes/
/deploy.ps1
/deploy-local.gradle
