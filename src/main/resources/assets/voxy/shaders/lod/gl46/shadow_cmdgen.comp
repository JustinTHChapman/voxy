#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 128) in;

// Bindings mirror cmdgen.comp but use shadow-specific buffers:
//   1 = shadow draw command buffer (write)
//   2 = shadow count buffer        (read/write)
//   3 = section metadata buffer    (read)
//   5 = shadow position scratch    (write)
// No visibility buffer — every section with geometry casts shadows.

#define DRAW_BUFFER_BINDING 1
#define SECTION_METADATA_BUFFER_BINDING 3
#define POSITION_SCRATCH_BINDING 5
#define POSITION_SCRATCH_ACCESS writeonly

#import <voxy:lod/section.glsl>
#import <voxy:lod/gl46/bindings.glsl>

// Shadow-specific count buffer (binding 2 — distinct struct from DrawCommandCountBuffer).
layout(binding = 2, std430) restrict buffer ShadowCountBuffer {
    uint shadowDrawCount;     // [0] draw commands emitted (read by GL_PARAMETER_BUFFER)
    uint shadowPosCount;      // [1] position slots used   (internal)
    uint totalSections;       // [2] metadata slots to scan (set by Java before dispatch)
    uint vanillaRDSections;   // [3] vanilla render distance in LOD-0 section units (32 blocks each)
};

void writeCmd(uint idx, uint instance, uint offset, uint quadCount) {
    DrawCommand cmd;
    cmd.count = quadCount * 6;
    cmd.instanceCount = 1;
    cmd.firstIndex = 0;
    cmd.baseVertex = int(offset) << 2;
    cmd.baseInstance = instance;
    cmdBuffer[idx] = cmd;
}

void main() {
    uint sectionId = gl_GlobalInvocationID.x;
    if (sectionId >= totalSections) return;

    SectionMeta meta = sectionData[sectionId];
    uvec4 counts = meta.b;

    // Skip empty / unallocated slots (Java zeroes the metadata entry on removal).
    if ((counts.x | counts.y | counts.z | counts.w) == 0u) return;

    uint ptr = extractQuadStart(meta);
    uint detail = extractDetail(meta);

    // Skip LOD 0 and LOD 1 — vanilla terrain covers those ranges.
    if (detail < 2u) return;

    // Skip sections whose nearest XZ corner to the player falls within vanilla render
    // distance.  Those sections overlap with vanilla-rendered terrain; their coarse LOD
    // geometry does not match the real geometry and produces phantom shadows that shift
    // as the player moves.  Only sections entirely outside vanilla RD should shadow.
    {
        ivec3 minCorner = getLoDPosition(meta.a.xy) << int(detail);
        int   lodSize   = 1 << int(detail);                        // section width in LOD-0 units
        ivec2 nearestXZ = clamp(baseSectionPos.xz,
                                minCorner.xz,
                                minCorner.xz + ivec2(lodSize));
        ivec2 deltaXZ   = abs(nearestXZ - baseSectionPos.xz);
        if (max(deltaXZ.x, deltaXZ.y) < int(vanillaRDSections)) return;
    }

    // Allocate a unique position-buffer slot for this section.
    uint drawId = atomicAdd(shadowPosCount, 1u);
    positionBuffer[drawId] = extractRawPos(meta);

    // Include all non-empty face groups — no player-relative face-direction filter.
    // The sun direction drives shadow visibility, not the player camera, so emitting
    // all faces avoids view-dependent popping as the player moves.
    uint msk = 0u;
    msk |= uint((counts.y        & 0xFFFFu) != 0u) << 0; // down
    msk |= uint(((counts.y>>16)  & 0xFFFFu) != 0u) << 1; // up
    msk |= uint((counts.z        & 0xFFFFu) != 0u) << 2; // north
    msk |= uint(((counts.z>>16)  & 0xFFFFu) != 0u) << 3; // south
    msk |= uint((counts.w        & 0xFFFFu) != 0u) << 4; // west
    msk |= uint(((counts.w>>16)  & 0xFFFFu) != 0u) << 5; // east
    msk |= uint(((counts.x>>16)  & 0xFFFFu) != 0u) << 6; // double-sided

    uint cmdCnt = bitCount(msk);
    if (cmdCnt == 0u) return;

    uint cmdPtr = atomicAdd(shadowDrawCount, cmdCnt);

    // Advance past translucent quads (not rendered in shadow pass).
    ptr += counts.x & 0xFFFFu;

    uint count;

    // Double-sided
    count = (counts.x >> 16) & 0xFFFFu;
    if ((msk & (1u << 6)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
    ptr += count;

    // Down
    count = counts.y & 0xFFFFu;
    if ((msk & (1u << 0)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
    ptr += count;

    // Up
    count = (counts.y >> 16) & 0xFFFFu;
    if ((msk & (1u << 1)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
    ptr += count;

    // North
    count = counts.z & 0xFFFFu;
    if ((msk & (1u << 2)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
    ptr += count;

    // South
    count = (counts.z >> 16) & 0xFFFFu;
    if ((msk & (1u << 3)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
    ptr += count;

    // West
    count = counts.w & 0xFFFFu;
    if ((msk & (1u << 4)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
    ptr += count;

    // East
    count = (counts.w >> 16) & 0xFFFFu;
    if ((msk & (1u << 5)) != 0u) writeCmd(cmdPtr++, drawId, ptr, count);
}
